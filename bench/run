#!/bin/bash

# Kestrel kernel A/B harness. Run it once per kernel (boot stock `linux`, then
# `linux-kestrel`), then compare the result directories. CPU and scheduler
# metrics are meaningful in the VM; footprint metrics are too; desktop metrics
# (compositor/shell CPU and RSS, idle GPU, wakeups) need a live session and bare
# metal.
#
# Usage: bench/run [label]
# Modes: KESTREL_BENCH_MODE=cpu|footprint|desktop|all (default all)
# Results: bench/results/<timestamp>-<label>/

set -euo pipefail

label="${1:-$(uname -r)}"
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
out="${KESTREL_BENCH_OUT:-$here/results/$(date +%Y%m%d-%H%M%S)-${label//\//_}}"
mkdir -p "$out"
dur="${KESTREL_BENCH_SECONDS:-60}"
mode="${KESTREL_BENCH_MODE:-all}"
variant="${KESTREL_VARIANT:-unlabelled}"
pkgs="${KESTREL_BENCH_PACKAGES:-linux linux-kestrel systemd hyprland quickshell foot zen-browser glibc}"

case "$mode" in
  cpu|footprint|desktop|session|all) ;;
  *) echo "KESTREL_BENCH_MODE must be one of: cpu footprint desktop session all" >&2; exit 2 ;;
esac

want() { [[ "$mode" == all || "$mode" == "$1" ]]; }
have() { command -v "$1" >/dev/null 2>&1; }
as_root() { if (( EUID == 0 )); then "$@"; else sudo -n "$@"; fi; }

gpu_vram_used_mib() {
  local f v
  if have nvidia-smi; then
    v="$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -1 || true)"
    [[ $v =~ ^[0-9]+$ ]] && { echo "$v"; return; }
  fi
  for f in /sys/class/drm/card*/device/mem_info_vram_used; do
    [[ -r $f ]] || continue
    v="$(<"$f")"
    awk -v b="$v" 'BEGIN { printf "%.0f", b / 1048576 }'
    return
  done
  echo missing
}

proc_vram_kb() {
  local pid="$1" f k v total=0
  [[ -n $pid && -r /proc/$pid/fdinfo ]] || { echo 0; return; }
  for f in /proc/"$pid"/fdinfo/*; do
    [[ -r $f ]] || continue
    while read -r k v _; do
      [[ $k == drm-memory-vram: ]] && total=$((total + ${v:-0}))
    done <"$f"
  done
  echo "$total"
}

sys_snapshot() {
  local dir="$1" f p z
  mkdir -p "$dir"
  for f in stat vmstat meminfo interrupts softirqs diskstats loadavg; do
    cp "/proc/$f" "$dir/$f" 2>/dev/null || true
  done
  cp /proc/net/dev "$dir/netdev" 2>/dev/null || true
  for f in cpu memory io; do
    cp "/proc/pressure/$f" "$dir/pressure-$f" 2>/dev/null || true
  done
  : >"$dir/cpufreq"
  for p in /sys/devices/system/cpu/cpufreq/policy*; do
    [[ -r $p/cur_freq ]] || continue
    printf '%s %s %s %s %s %s\n' \
      "$(cat "$p/cur_freq" 2>/dev/null || echo 0)" \
      "$(cat "$p/cpuinfo_max_freq" 2>/dev/null || echo 0)" \
      "$(cat "$p/cpuinfo_min_freq" 2>/dev/null || echo 0)" \
      "$(cat "$p/scaling_max_freq" 2>/dev/null || echo 0)" \
      "$(cat "$p/scaling_min_freq" 2>/dev/null || echo 0)" \
      "$(cat "$p/scaling_governor" 2>/dev/null || echo unknown)" >>"$dir/cpufreq"
  done
  : >"$dir/thermal"
  for z in /sys/class/thermal/thermal_zone*; do
    [[ -r $z/temp ]] || continue
    printf '%s %s\n' "$(cat "$z/type" 2>/dev/null || basename "$z")" \
      "$(cat "$z/temp" 2>/dev/null || echo 0)" >>"$dir/thermal"
  done
  : >"$dir/rapl"
  for f in /sys/class/powercap/intel-rapl:*/energy_uj; do
    [[ -r $f ]] || continue
    printf '%s %s\n' "$f" "$(cat "$f" 2>/dev/null || echo 0)" >>"$dir/rapl"
  done
}

top_snapshot() {
  local dir="$1" p pid u s v n r
  mkdir -p "$dir"
  : >"$dir/top.tsv"
  for p in /proc/[0-9]*; do
    pid="${p##*/}"
    [[ -r $p/stat ]] || continue
    read -r u s < <(awk '{ print $14, $15 }' "$p/stat" 2>/dev/null) || continue
    v="$(awk '/^voluntary_ctxt_switches:/{ print $2 }' "$p/status" 2>/dev/null || echo 0)"
    n="$(awk '/^nonvoluntary_ctxt_switches:/{ print $2 }' "$p/status" 2>/dev/null || echo 0)"
    r="$(awk '/^VmRSS:/{ print $2 }' "$p/status" 2>/dev/null || echo 0)"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$pid" \
      "$(cat "$p/comm" 2>/dev/null || echo '?')" "$((u + s))" "${v:-0}" "${n:-0}" "${r:-0}" \
      >>"$dir/top.tsv"
  done
}

top_report() {
  local dir="$1" outdir="$2" e="$3" hz="$4" f
  [[ -f $dir/before/top.tsv && -f $dir/after/top.tsv ]] || return 0
  {
    printf 'pid\tcomm\tcpu_pct\tvol_s\tinvol_s\n'
    awk -F'\t' -v hz="$hz" -v e="$e" '
      FNR == NR { c[$1] = $3; v[$1] = $4; n[$1] = $5; next }
      ($1 in c) {
        printf "%s\t%s\t%.2f\t%.2f\t%.2f\n", $1, $2,
          100 * (($3 - c[$1]) / hz) / e, ($4 - v[$1]) / e, ($5 - n[$1]) / e
      }' "$dir/before/top.tsv" "$dir/after/top.tsv" | sort -k3 -nr | head -20
  } >"$outdir/top-cpu.txt"
  {
    printf 'pid\tcomm\tcpu_pct\tvol_s\tinvol_s\tctx_s\n'
    awk -F'\t' -v hz="$hz" -v e="$e" '
      FNR == NR { c[$1] = $3; v[$1] = $4; n[$1] = $5; next }
      ($1 in c) {
        printf "%s\t%s\t%.2f\t%.2f\t%.2f\t%.2f\n", $1, $2,
          100 * (($3 - c[$1]) / hz) / e, ($4 - v[$1]) / e, ($5 - n[$1]) / e,
          (($4 - v[$1]) + ($5 - n[$1])) / e
      }' "$dir/before/top.tsv" "$dir/after/top.tsv" | sort -k6 -nr | head -20
  } >"$outdir/top-wakeups.txt"
  {
    printf 'pid\tcomm\trss_kb\n'
    awk -F'\t' '{ printf "%s\t%s\t%s\n", $1, $2, $6 }' "$dir/after/top.tsv" |
      sort -k3 -nr | head -20
  } >"$outdir/top-rss.txt"
  if [[ -f $dir/before/interrupts && -f $dir/after/interrupts ]]; then
    {
      printf 'irq\tdelta\tper_s\n'
      awk -v e="$e" '
        FNR == NR {
          if ($1 ~ /^[0-9]+:$/) {
            s = 0; for (i = 2; i <= NF; i++) { if ($i !~ /^[0-9]+$/) break; s += $i }
            old[$1] = s
          }
          next
        }
        {
          if ($1 !~ /^[0-9]+:$/) next
          s = 0; for (i = 2; i <= NF; i++) { if ($i !~ /^[0-9]+$/) break; s += $i }
          printf "%s\t%d\t%.2f\n", $1, s - old[$1], (s - old[$1]) / e
        }' "$dir/before/interrupts" "$dir/after/interrupts" | sort -k3 -nr | head -20
    } >"$outdir/top-irqs.txt"
  fi
  if [[ -f $dir/before/softirqs && -f $dir/after/softirqs ]]; then
    {
      printf 'softirq\tdelta\tper_s\n'
      awk -v e="$e" '
        FNR == NR {
          s = 0; for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+$/) s += $i
          old[$1] = s; next
        }
        {
          s = 0; for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+$/) s += $i
          printf "%s\t%d\t%.2f\n", $1, s - old[$1], (s - old[$1]) / e
        }' "$dir/before/softirqs" "$dir/after/softirqs" | sort -k3 -nr | head -20
    } >"$outdir/top-softirqs.txt"
  fi
}

summary="$out/summary.txt"
: >"$summary"

# System identity, so a result directory is self-describing.
{
  echo "kernel=$(uname -r)"
  echo "label=$label"
  echo "mode=$mode"
  echo "cpu=$(awk -F: '/model name/{sub(/^ /, "", $2); print $2; exit}' /proc/cpuinfo)"
  echo "nproc=$(nproc)"
  echo "governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo unknown)"
  echo "scx_state=$(cat /sys/kernel/sched_ext/state 2>/dev/null || echo none)"
  echo "scx=$(scxctl get 2>/dev/null | tr '\n' ' ' || echo none)"
  echo "cmdline=$(</proc/cmdline)"
  echo "gpu_vram_used_mib=$(gpu_vram_used_mib)"
  if have hyprctl && have jq; then
    monitors="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | "\(.name) \(.width)x\(.height)@\(.refreshRate) scale=\(.scale) format=\(.currentFormat // "?")"' 2>/dev/null | paste -sd'|' -)"
    [[ -n $monitors ]] && echo "monitors=$monitors"
  fi
  echo "variant=$variant"
  echo "kernel_hint_supported=$(kestrel-hint supported 2>/dev/null || echo no)"
  # Package versions make a result directory comparable after an update and
  # let the package-codegen axis be checked from the artifact alone.
  for p in $pkgs; do
    v="$(pacman -Q "$p" 2>/dev/null | awk '{ print $2 }')" || true
    [[ -n ${v:-} ]] && echo "pkg_${p}=$v"
    sz="$(pacman -Qi "$p" 2>/dev/null | awk -F': ' '/^Installed Size/{ print $2; exit }')" || true
    case "${sz:-}" in
      *GiB) kb="$(awk -v x="${sz% GiB}" 'BEGIN { printf "%.0f", x * 1048576 }')" ;;
      *MiB) kb="$(awk -v x="${sz% MiB}" 'BEGIN { printf "%.0f", x * 1024 }')" ;;
      *KiB) kb="${sz% KiB}" ;;
      *B)   kb="$(awk -v x="${sz% B}" 'BEGIN { printf "%.3f", x / 1024 }')" ;;
      *)    kb="" ;;
    esac
    [[ -n $kb ]] && echo "pkg_${p}_installed_kb=$kb"
  done
  true
} | tee "$summary" | sed 's/^/  /'

# --- CPU and scheduler -------------------------------------------------------
if want cpu; then

  # Wakeup latency and throughput under scheduling pressure.
  if have schbench; then
    echo "schbench ${dur}s..."
    schbench -F 256 -n 5 -r "$dur" >"$out/schbench.txt" 2>&1 || true
    awk '
      function out(k, v) { printf "%s=%s\n", k, (v == "" ? "missing" : v) }
      /Wakeup Latencies/  { sec = "w"; next }
      /Request Latencies/ { sec = "r"; next }
      /RPS percentiles/   { sec = "rps"; next }
      /^[[:space:]]*(50.0th|90.0th|99.0th|99.9th):/ {
        p = $1; sub(/:$/, "", p)
        if (sec == "w") { if (p == "50.0th") w50 = $2; else if (p == "90.0th") w90 = $2; else if (p == "99.0th") w99 = $2; else w999 = $2 }
        else if (sec == "r") { if (p == "50.0th") r50 = $2; else if (p == "90.0th") r90 = $2; else if (p == "99.0th") r99 = $2; else r999 = $2 }
        else if (sec == "rps") { if (p == "50.0th") rps50 = $2; else if (p == "90.0th") rps90 = $2 }
        next
      }
      /^[[:space:]]*min=/ {
        for (i = 1; i <= NF; i++) {
          if ($i ~ /^min=/) { sub(/^min=/, "", $i); sub(/,/, "", $i); v = $i }
          if ($i ~ /^max=/) { sub(/^max=/, "", $i); x = $i }
        }
        if (sec == "w") { wmin = v; wmax = x }
        else if (sec == "r") { rmin = v; rmax = x }
        next
      }
      /^average rps:/ { rps = $3 }
      /^current rps:/ { cur = $3 }
      /^sched delay:/ { msg = $4; worker = $7 }
      END {
        out("schbench_wakeup_p50_us", w50); out("schbench_wakeup_p90_us", w90)
        out("schbench_wakeup_p99_us", w99); out("schbench_wakeup_p999_us", w999)
        out("schbench_wakeup_min_us", wmin); out("schbench_wakeup_max_us", wmax)
        out("schbench_request_p50_us", r50); out("schbench_request_p90_us", r90)
        out("schbench_request_p99_us", r99); out("schbench_request_p999_us", r999)
        out("schbench_request_min_us", rmin); out("schbench_request_max_us", rmax)
        out("schbench_rps", rps); out("schbench_current_rps", cur)
        out("schbench_rps_p50", rps50); out("schbench_rps_p90", rps90)
        out("schbench_sched_delay_msg_us", msg); out("schbench_sched_delay_worker_us", worker)
      }' "$out/schbench.txt" >>"$summary"
  else
    echo "schbench_wakeup_p50_us=missing" >>"$summary"
  fi

  # Worst-case timer latency under load.
  if have cyclictest; then
    echo "cyclictest 30s..."
    as_root cyclictest --mlockall --smp --priority 99 --interval 200 --distance 0 \
      --loops 150000 >"$out/cyclictest.txt" 2>&1 || true
    awk '
      /^T:/ {
        for (i = 1; i <= NF; i++) {
          if ($i == "Max:") m = $(i + 1)
          if ($i == "Avg:") a = $(i + 1)
        }
        if (m + 0 > mx) mx = m + 0
        if (!seen || m + 0 < mn) mn = m + 0
        if (a + 0 > av) av = a + 0
        seen = 1
      }
      END {
        printf "cyclictest_min_us=%s\n", (seen ? mn : "missing")
        printf "cyclictest_max_us=%s\n", mx
        printf "cyclictest_avg_us=%s\n", av
      }' "$out/cyclictest.txt" >>"$summary"
  else
    echo "cyclictest_max_us=missing" >>"$summary"
  fi

  # CPU throughput.
  if have stress-ng; then
    echo "stress-ng 30s..."
    stress-ng --cpu 0 --cpu-method all --timeout 30s --metrics-brief \
      >"$out/stress-ng.txt" 2>&1 || true
    read -r ops total real usr sys ops2 <<<"$(awk '
      /stress-ng: metrc:/ && /cpu/ { print $9, $5, $6, $7, $8, $10; exit }' \
      "$out/stress-ng.txt")"
    echo "stress_cpu_bogo_ops=${ops:-missing}" >>"$summary"
    echo "stress_cpu_bogo_ops_total=${total:-missing}" >>"$summary"
    echo "stress_cpu_real_s=${real:-missing}" >>"$summary"
    echo "stress_cpu_usr_s=${usr:-missing}" >>"$summary"
    echo "stress_cpu_sys_s=${sys:-missing}" >>"$summary"
    echo "stress_cpu_usr_sys_ops_s=${ops2:-missing}" >>"$summary"
  else
    echo "stress_cpu_bogo_ops=missing" >>"$summary"
  fi

fi

# --- Footprint ---------------------------------------------------------------
if want footprint; then
  echo "footprint..."
  kernver="$(uname -r)"
  moddir="/usr/lib/modules/$kernver"
  pkgbase="$(cat "$moddir/pkgbase" 2>/dev/null || echo unknown)"

  # On-disk size of the running kernel: image + module tree. Lower is better.
  # Arch installs the image under the module dir; UKI systems have no
  # /boot/vmlinuz-*, so try the module dir first and fall back to /boot.
  img="$moddir/vmlinuz"
  [[ -f $img ]] || img="/boot/vmlinuz-$pkgbase"
  if [[ -f $img ]]; then
    echo "kernel_image_bytes=$(stat -c%s "$img")" >>"$summary"
  else
    echo "kernel_image_bytes=missing" >>"$summary"
  fi
  if [[ -d $moddir ]]; then
    echo "modules_bytes=$(du -sb "$moddir" | cut -f1)" >>"$summary"
    echo "modules_count=$(find "$moddir/kernel" -type f -name '*.ko*' 2>/dev/null | wc -l)" >>"$summary"
  else
    echo "modules_bytes=missing" >>"$summary"
    echo "modules_count=missing" >>"$summary"
  fi

  echo "loaded_modules=$(ls /sys/module | wc -l)" >>"$summary"

  # Kernel memory footprint, straight from /proc/meminfo. Lower is better.
  mi() { awk -v k="$1:" '$1==k { r=$2 } END { print (r=="" ? "missing" : r) }' /proc/meminfo; }
  echo "meminfo_slab_kb=$(mi Slab)" >>"$summary"
  echo "meminfo_sreclaimable_kb=$(mi SReclaimable)" >>"$summary"
  echo "meminfo_sunreclaim_kb=$(mi SUnreclaim)" >>"$summary"
  echo "meminfo_kernel_stack_kb=$(mi KernelStack)" >>"$summary"
  echo "meminfo_page_tables_kb=$(mi PageTables)" >>"$summary"
  echo "meminfo_vmalloc_used_kb=$(mi VmallocUsed)" >>"$summary"

  # Boot time breakdown. Lower is better. Each term carries its own unit, and
  # the "=" total can be "Xmin Y.ZZZs", so sum the terms instead of parsing it.
  if have systemd-analyze; then
    systemd-analyze >"$out/systemd-analyze.txt" 2>&1 || true
    read -r bfw bld bkn bus btotal <<<"$(awk '
      /Startup finished in/ {
        total = $NF
        for (i = 1; i <= NF; i++) {
          if ($i == "(firmware)")  fw = $(i - 1)
          if ($i == "(loader)")    ld = $(i - 1)
          if ($i == "(kernel)")    kn = $(i - 1)
          if ($i == "(userspace)") us = $(i - 1)
        }
      }
      END {
        print (fw == "" ? "-" : fw), (ld == "" ? "-" : ld),
              (kn == "" ? "-" : kn), (us == "" ? "-" : us),
              (total == "" ? "-" : total)
      }' "$out/systemd-analyze.txt")"
    secs() {
      case "$1" in
        *ms)  awk -v v="${1%ms}"  'BEGIN { printf "%.3f", v / 1000 }' ;;
        *min) awk -v v="${1%min}" 'BEGIN { printf "%.3f", v * 60 }' ;;
        *s)   printf '%s' "${1%s}" ;;
        *)    printf 'missing' ;;
      esac
    }
    fwv="$(secs "${bfw:-}")"
    ldv="$(secs "${bld:-}")"
    knv="$(secs "${bkn:-}")"
    usv="$(secs "${bus:-}")"
    echo "boot_firmware_s=$fwv" >>"$summary"
    echo "boot_loader_s=$ldv" >>"$summary"
    echo "boot_kernel_s=$knv" >>"$summary"
    echo "boot_userspace_s=$usv" >>"$summary"
    echo "boot_total_s=$(secs "$btotal")" >>"$summary"
  else
    echo "boot_total_s=missing" >>"$summary"
  fi
fi

# --- Desktop -----------------------------------------------------------------
if want desktop; then
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && have hyprctl; then
    desktop_dur="${KESTREL_BENCH_DESKTOP_SECONDS:-10}"
    echo "desktop sample ${desktop_dur}s..."

    pid_of() { pgrep -x "$1" 2>/dev/null | head -1; }

    cpu_pct() {
      local pat="$1" pid hz t1 t2 u1 s1 u2 s2
      pid="$(pid_of "$pat")"
      [[ -n $pid ]] || { echo missing; return; }
      hz="$(getconf CLK_TCK)"
      t1="$(date +%s.%N)"
      read -r u1 s1 <<<"$(awk '{ print $14, $15 }' "/proc/$pid/stat")"
      sleep "$desktop_dur"
      t2="$(date +%s.%N)"
      read -r u2 s2 <<<"$(awk '{ print $14, $15 }' "/proc/$pid/stat")"
      awk -v u1="$u1" -v s1="$s1" -v u2="$u2" -v s2="$s2" -v hz="$hz" -v t1="$t1" -v t2="$t2" \
        'BEGIN { d = ((u2 + s2) - (u1 + s1)) / hz; e = t2 - t1; if (e <= 0) print "missing"; else printf "%.2f", 100 * d / e }'
    }

    rss_kb() {
      local pid
      pid="$(pid_of "$1")"
      [[ -n $pid ]] || { echo missing; return; }
      awk '/^VmRSS:/ { print $2 }' "/proc/$pid/status"
    }

    echo "desktop_hyprland_cpu_pct=$(cpu_pct Hyprland)" >>"$summary"
    echo "desktop_quickshell_cpu_pct=$(cpu_pct quickshell)" >>"$summary"
    echo "desktop_hyprland_rss_kb=$(rss_kb Hyprland)" >>"$summary"
    echo "desktop_quickshell_rss_kb=$(rss_kb quickshell)" >>"$summary"
    hp="$(pid_of Hyprland)"; qs="$(pid_of quickshell)"
    echo "desktop_hyprland_vram_mib=$(awk -v k="$(proc_vram_kb "$hp")" 'BEGIN { printf "%.0f", k / 1024 }')" >>"$summary"
    echo "desktop_quickshell_vram_mib=$(awk -v k="$(proc_vram_kb "$qs")" 'BEGIN { printf "%.0f", k / 1024 }')" >>"$summary"

    if have nvidia-smi; then
      nv="$(nvidia-smi --query-gpu=memory.used,power.draw,utilization.gpu \
        --format=csv,noheader,nounits 2>/dev/null | head -1 || true)"
      IFS=, read -r nvmem nvpow nvutil <<<"$nv" || true
      if [[ ${nvmem:-} =~ ^[[:space:]]*[0-9]+[[:space:]]*$ ]]; then
        echo "desktop_nvidia_mem_mib=${nvmem// /}" >>"$summary"
        echo "desktop_nvidia_power_w=${nvpow// /}" >>"$summary"
        echo "desktop_nvidia_util_pct=${nvutil// /}" >>"$summary"
      else
        echo "desktop_nvidia_mem_mib=missing" >>"$summary"
        echo "desktop_nvidia_power_w=missing" >>"$summary"
        echo "desktop_nvidia_util_pct=missing" >>"$summary"
      fi
    fi

    if have powertop && [[ $EUID -eq 0 ]]; then
      powertop --csv="$out/powertop.csv" --time="$desktop_dur" >/dev/null 2>&1 || true
      wk="$(awk -F'","' 'tolower($0) ~ /wakeups-from-idle/ { print $2; exit }' "$out/powertop.csv" 2>/dev/null || true)"
      echo "desktop_powertop_wakeups=${wk:-missing}" >>"$summary"
    fi
  else
    echo "desktop=skipped (no Hyprland session; needs bare metal)" | tee -a "$summary" | sed 's/^/  /'
  fi
fi

# --- Session (Kestrel bridge A/B) --------------------------------------------
# Drives a scripted four-app workload (terminal load, browser tabs, compositor
# window churn) and reports per-class CPU, wakeups and RSS. Class membership
# prefers the kestrel.slice cgroup hierarchy (section 1 of the kernel-bridge
# plan) and falls back to process-name matching so it runs before that exists.
# VM-valid; it measures scheduler/wakeup/RSS, not GPU or frame time.
if want session; then
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && have hyprctl; then
    session_dur="${KESTREL_BENCH_SESSION_SECONDS:-30}"
    echo "session workload ${session_dur}s..."
    sess="$out/session"; mkdir -p "$sess"

    class_root=
    base="/sys/fs/cgroup/user.slice/user-$(id -u).slice"
    for d in "$base"/user@*.service; do
      [[ -d $d/kestrel.slice ]] && { class_root="$d/kestrel.slice"; break; }
    done
    [[ -n $class_root ]] || class_root="$base/kestrel.slice"
    class_dirs() {
      case "$1" in
        browser)
          printf '%s\n' "$class_root/kestrel-browser.slice/active" "$class_root/kestrel-browser.slice/background"
          ;;
        *)
          printf '%s\n' "$class_root/kestrel-$1.slice"
          ;;
      esac
    }

    class_pids() {
      local class="$1" dir
      # Union of the class cgroup and the name match: the cgroup can be empty
      # (bridge off) and the broker only places focused trees, so neither alone
      # is complete. A stable class definition is what makes the variants
      # comparable; placement itself is checked from the cgroup counts.
      {
        while read -r dir; do
          [[ -d $dir ]] || continue
          find "$dir" -name cgroup.procs -exec cat {} + 2>/dev/null || true
        done < <(class_dirs "$class")
        case "$class" in
          desktop) { pgrep -x Hyprland; pgrep -x quickshell; } 2>/dev/null || true ;;
          term)    { pgrep -x foot; pgrep -x footclient; } 2>/dev/null || true ;;
          browser) pgrep -f 'zen|Isolated Web Co|Web Content' 2>/dev/null || true ;;
        esac
      } | sort -un
    }

    # Per-class counters. CPU and faults come from /proc/<pid>/stat, memory from
    # status/smaps_rollup, I/O and context switches from io/status and the
    # scheduler wait/slice counters from each thread's schedstat.
    snapshot() {
      local class="$1" p t
      local cpu=0 vol=0 nvol=0 rss=0 pss=0 wait=0 slices=0 vram=0 threads=0
      local minf=0 majf=0 readb=0 writeb=0 procs=0
      local panon=0 pfile=0 pshmem=0 pdirty=0 pswap=0 phuge=0
      local c mf mj v n r ps pa pf psh pd sw ah w q vr rb wb
      while read -r p; do
        [[ -r /proc/$p/stat ]] || continue
        procs=$((procs + 1))
        read -r c mf mj < <(awk '{ print $14 + $15, $10, $12 }' "/proc/$p/stat" 2>/dev/null) || { c=0; mf=0; mj=0; }
        r="$(awk '/^VmRSS:/{ print $2 }' "/proc/$p/status" 2>/dev/null || echo 0)"
        read -r ps pa pf psh pd sw ah < <(awk '
          /^Pss:/{ ps = $2 } /^Pss_Anon:/{ pa = $2 } /^Pss_File:/{ pf = $2 }
          /^Pss_Shmem:/{ psh = $2 } /^Private_Dirty:/{ pd = $2 }
          /^Swap:/{ sw = $2 } /^AnonHugePages:/{ ah = $2 }
          END { print ps + 0, pa + 0, pf + 0, psh + 0, pd + 0, sw + 0, ah + 0 }' \
          "/proc/$p/smaps_rollup" 2>/dev/null) || { ps=0; pa=0; pf=0; psh=0; pd=0; sw=0; ah=0; }
        read -r rb wb < <(awk '$1 == "read_bytes:" { r = $2 } $1 == "write_bytes:" { w = $2 } END { print r + 0, w + 0 }' "/proc/$p/io" 2>/dev/null) || { rb=0; wb=0; }
        vr="$(proc_vram_kb "$p")"
        cpu=$((cpu + ${c:-0})); minf=$((minf + ${mf:-0})); majf=$((majf + ${mj:-0}))
        rss=$((rss + ${r:-0})); pss=$((pss + ${ps:-0})); vram=$((vram + ${vr:-0}))
        panon=$((panon + ${pa:-0})); pfile=$((pfile + ${pf:-0})); pshmem=$((pshmem + ${psh:-0}))
        pdirty=$((pdirty + ${pd:-0})); pswap=$((pswap + ${sw:-0})); phuge=$((phuge + ${ah:-0}))
        readb=$((readb + ${rb:-0})); writeb=$((writeb + ${wb:-0}))
        for t in /proc/"$p"/task/*; do
          read -r v n < <(awk '/^voluntary_ctxt_switches:/ { v = $2 } /^nonvoluntary_ctxt_switches:/ { n = $2 } END { print v + 0, n + 0 }' "$t/status" 2>/dev/null) || { v=0; n=0; }
          read -r _ w q <"$t/schedstat" 2>/dev/null || { w=0; q=0; }
          vol=$((vol + ${v:-0})); nvol=$((nvol + ${n:-0}))
          wait=$((wait + ${w:-0})); slices=$((slices + ${q:-0}))
          threads=$((threads + 1))
        done
      done < <(class_pids "$class")
      printf '%s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s\n' \
        "$cpu" "$vol" "$nvol" "$rss" "$pss" "$wait" "$slices" "$vram" \
        "$threads" "$minf" "$majf" "$readb" "$writeb" "$procs" \
        "$panon" "$pfile" "$pshmem" "$pdirty" "$pswap" "$phuge"
    }

    start_workloads() {
      local secs="$1"
      if [[ -z ${KESTREL_SESSION_NO_APPS:-} ]]; then
        if have footclient && [[ -S ${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/foot.sock ]]; then
          local _i
          for ((_i = 0; _i < ${KESTREL_SESSION_TERMS:-2}; _i++)); do
            footclient -e sh -c "timeout $((secs + 5)) sh -c 'while :; do :; done'" >/dev/null 2>&1 &
          done
        elif have foot; then
          local _i
          for ((_i = 0; _i < ${KESTREL_SESSION_TERMS:-2}; _i++)); do
            foot -e sh -c "timeout $((secs + 5)) sh -c 'while :; do :; done'" >/dev/null 2>&1 &
          done
        fi
        if have zen-browser; then
          for ((_i = 0; _i < ${KESTREL_SESSION_TABS:-4}; _i++)); do
            zen-browser --new-tab about:blank >/dev/null 2>&1 &
          done
        fi
      fi
      (
        end=$((SECONDS + secs))
        while ((SECONDS < end)); do
          hyprctl dispatch workspace e+1 >/dev/null 2>&1 || true; sleep 1
          hyprctl dispatch workspace e-1 >/dev/null 2>&1 || true; sleep 1
        done
      ) &
      # Contention is what the bridge is for; without it the interactive
      # classes never queue and every variant looks identical.
      if (( ${KESTREL_SESSION_BG_CPUS:-0} > 0 )) && have stress-ng; then
        stress-ng --cpu "$KESTREL_SESSION_BG_CPUS" --cpu-method matrixprod \
          --timeout "${secs}s" --metrics-brief >"$sess/background.txt" 2>&1 &
        bg_pid=$!
      fi
    }
    bg_pid=

    classes=(desktop term browser)
    cgroup_count() {
      local dir n=0
      while read -r dir; do
        [[ -d $dir ]] || continue
        n=$((n + $(find "$dir" -name cgroup.procs -exec cat {} + 2>/dev/null | sort -un | wc -l)))
      done < <(class_dirs "$1")
      echo "$n"
    }
    cgroup_stats() {
      local class="$1" dir found=0 mem=0 peak=0 cpu=0 pids=0
      local high=0 max=0 oom=0 oomk=0 weight=0 weights=0
      local v
      while read -r dir; do
        [[ -d $dir ]] || continue
        found=1
        [[ -r $dir/memory.current ]] && mem=$((mem + $(cat "$dir/memory.current" 2>/dev/null || echo 0)))
        [[ -r $dir/memory.peak ]] && peak=$((peak + $(cat "$dir/memory.peak" 2>/dev/null || echo 0)))
        if [[ -r $dir/cpu.stat ]]; then
          v="$(awk '$1 == "usage_usec" { print $2; exit }' "$dir/cpu.stat" 2>/dev/null || true)"
          cpu=$((cpu + ${v:-0}))
        fi
        [[ -r $dir/pids.current ]] && pids=$((pids + $(cat "$dir/pids.current" 2>/dev/null || echo 0)))
        if [[ -r $dir/memory.events ]]; then
          read -r high max oom oomk < <(awk '
            $1 == "high" { h = $2 } $1 == "max" { m = $2 }
            $1 == "oom" { o = $2 } $1 == "oom_kill" { k = $2 }
            END { print h + 0, m + 0, o + 0, k + 0 }' "$dir/memory.events" 2>/dev/null) || { high=0; max=0; oom=0; oomk=0; }
        fi
        if [[ -r $dir/cpu.weight ]]; then
          v="$(cat "$dir/cpu.weight" 2>/dev/null || true)"
          [[ $v =~ ^[0-9]+$ ]] && { weight=$((weight + v)); weights=$((weights + 1)); }
        fi
      done < <(class_dirs "$class")
      if ((found)); then
        echo "session_${class}_cgroup_memory_current_kb=$((mem / 1024))"
        echo "session_${class}_cgroup_memory_peak_kb=$((peak / 1024))"
        echo "session_${class}_cgroup_cpu_usage_ms=$((cpu / 1000))"
        echo "session_${class}_cgroup_pids_current=$pids"
        echo "session_${class}_cgroup_memory_events_high=$high"
        echo "session_${class}_cgroup_memory_events_max=$max"
        echo "session_${class}_cgroup_memory_events_oom=$oom"
        echo "session_${class}_cgroup_memory_events_oom_kill=$oomk"
        echo "session_${class}_cgroup_cpu_weight=$((weights ? weight / weights : 0))"
      fi
    }
    declare -A c1 v1 nv1 r1 p1 w1 q1 vr1 th1 mf1 mj1 rb1 wb1 np1 pa1 pf1 ps1 pd1 sw1 ah1
    for c in "${classes[@]}"; do
      read -r a b n d e f g h i j k l m o pa pf ps pd sw ah < <(snapshot "$c")
      c1[$c]="$a"; v1[$c]="$b"; nv1[$c]="$n"; r1[$c]="$d"; p1[$c]="$e"
      w1[$c]="$f"; q1[$c]="$g"; vr1[$c]="$h"; th1[$c]="$i"; mf1[$c]="$j"
      mj1[$c]="$k"; rb1[$c]="$l"; wb1[$c]="$m"; np1[$c]="$o"
      pa1[$c]="$pa"; pf1[$c]="$pf"; ps1[$c]="$ps"; pd1[$c]="$pd"; sw1[$c]="$sw"; ah1[$c]="$ah"
      echo "$c cpu=$a vol=$b nvol=$n rss=$d pss=$e wait_ns=$f slices=$g vram_kb=$h threads=$i minflt=$j majflt=$k readb=$l writeb=$m procs=$o pss_anon=$pa pss_file=$pf pss_shmem=$ps private_dirty=$pd swap=$sw anon_huge=$ah" >>"$sess/before.txt"
      echo "session_${c}_cgroup_pids=$(cgroup_count "$c")" >>"$summary"
    done
    echo "session_broker_active=$(systemctl --user is-active kestrel-broker.service 2>/dev/null || echo unknown)" >>"$summary"
    total=0
    for c in "${classes[@]}"; do total=$((total + $(cgroup_count "$c"))); done
    echo "session_cgroup_total=$total" >>"$summary"
    for c in "${classes[@]}"; do cgroup_stats "$c" >>"$summary"; done
    # Prove the variant really applied: the compositor hint is what "hints on"
    # restores and "hints off" clears.
    hp="$(pgrep -x Hyprland 2>/dev/null | head -1 || true)"
    if [[ -n $hp ]]; then
      echo "session_hyprland_hint=$(kestrel-hint get "$hp" 2>/dev/null || echo na)" >>"$summary"
    fi

    sysdir="$sess/system"; mkdir -p "$sysdir"
    sys_snapshot "$sysdir/before"
    top_snapshot "$sysdir/before"
    t1="$(date +%s.%N)"
    start_workloads "$session_dur"
    sleep "$session_dur"
    t2="$(date +%s.%N)"
    sys_snapshot "$sysdir/after"
    top_snapshot "$sysdir/after"

    hz="$(getconf CLK_TCK)"
    elapsed="$(awk -v a="$t1" -v b="$t2" 'BEGIN { printf "%.3f", b - a }')"
    "$here/sysstats" "$sysdir/before" "$sysdir/after" "$elapsed" >>"$summary" 2>/dev/null || true
    top_report "$sysdir" "$sess" "$elapsed" "$hz"
    for c in "${classes[@]}"; do
      read -r a b n d e f g h i j k l m o pa pf ps pd sw ah < <(snapshot "$c")
      echo "$c cpu=$a vol=$b nvol=$n rss=$d pss=$e wait_ns=$f slices=$g vram_kb=$h threads=$i minflt=$j majflt=$k readb=$l writeb=$m procs=$o pss_anon=$pa pss_file=$pf pss_shmem=$ps private_dirty=$pd swap=$sw anon_huge=$ah" >>"$sess/after.txt"
      cpu_pct="$(awk -v x="${c1[$c]}" -v y="$a" -v hz="$hz" -v e="$elapsed" \
        'BEGIN { d = y - x; if (d < 0) d = 0; if (e <= 0) print "missing"; else printf "%.2f", 100 * (d / hz) / e }')"
      wakeups="$(awk -v x="${v1[$c]}" -v y="$b" -v e="$elapsed" \
        'BEGIN { d = y - x; if (d < 0) d = 0; if (e <= 0) print "missing"; else printf "%.2f", d / e }')"
      invol="$(awk -v x="${nv1[$c]}" -v y="$n" -v e="$elapsed" \
        'BEGIN { d = y - x; if (d < 0) d = 0; if (e <= 0) print "missing"; else printf "%.2f", d / e }')"
      ctxt="$(awk -v vb="${v1[$c]}" -v va="$b" -v nb="${nv1[$c]}" -v na="$n" -v e="$elapsed" \
        'BEGIN { dv = va - vb; if (dv < 0) dv = 0; dn = na - nb; if (dn < 0) dn = 0; if (e <= 0) print "missing"; else printf "%.2f", (dv + dn) / e }')"
      wait_avg="$(awk -v x="${w1[$c]}" -v y="$f" -v sx="${q1[$c]}" -v sy="$g" \
        'BEGIN { dw = y - x; if (dw < 0) dw = 0; ds = sy - sx; if (ds <= 0) print "missing"; else printf "%.2f", (dw / ds) / 1000 }')"
      wait_ms="$(awk -v x="${w1[$c]}" -v y="$f" 'BEGIN { d = y - x; if (d < 0) d = 0; printf "%.3f", d / 1000000 }')"
      echo "session_${c}_cpu_pct=$cpu_pct" >>"$summary"
      echo "session_${c}_wakeups_per_s=$wakeups" >>"$summary"
      echo "session_${c}_involuntary_per_s=$invol" >>"$summary"
      echo "session_${c}_ctx_switches_per_s=$ctxt" >>"$summary"
      echo "session_${c}_rss_kb=${d:-missing}" >>"$summary"
      echo "session_${c}_pss_kb=${e:-missing}" >>"$summary"
      echo "session_${c}_pss_anon_kb=${pa:-missing}" >>"$summary"
      echo "session_${c}_pss_file_kb=${pf:-missing}" >>"$summary"
      echo "session_${c}_pss_shmem_kb=${ps:-missing}" >>"$summary"
      echo "session_${c}_private_dirty_kb=${pd:-missing}" >>"$summary"
      echo "session_${c}_swap_kb=${sw:-missing}" >>"$summary"
      echo "session_${c}_anon_huge_kb=${ah:-missing}" >>"$summary"
      echo "session_${c}_threads=${i:-missing}" >>"$summary"
      echo "session_${c}_procs=${o:-missing}" >>"$summary"
      echo "session_${c}_sched_wait_avg_us=$wait_avg" >>"$summary"
      echo "session_${c}_sched_wait_total_ms=$wait_ms" >>"$summary"
      slices=$((g - ${q1[$c]})); ((slices < 0)) && slices=0
echo "session_${c}_sched_slices=$slices" >>"$summary"
      echo "session_${c}_minflt_per_s=$(awk -v x="${mf1[$c]}" -v y="$j" -v e="$elapsed" 'BEGIN { d = y - x; if (d < 0) d = 0; if (e <= 0) print "missing"; else printf "%.2f", d / e }')" >>"$summary"
      echo "session_${c}_majflt_per_s=$(awk -v x="${mj1[$c]}" -v y="$k" -v e="$elapsed" 'BEGIN { d = y - x; if (d < 0) d = 0; if (e <= 0) print "missing"; else printf "%.2f", d / e }')" >>"$summary"
      echo "session_${c}_read_kb=$(awk -v x="${rb1[$c]}" -v y="$l" 'BEGIN { d = y - x; if (d < 0) d = 0; printf "%.1f", d / 1024 }')" >>"$summary"
      echo "session_${c}_write_kb=$(awk -v x="${wb1[$c]}" -v y="$m" 'BEGIN { d = y - x; if (d < 0) d = 0; printf "%.1f", d / 1024 }')" >>"$summary"
      echo "session_${c}_vram_mib=$(awk -v k="${h:-0}" 'BEGIN { printf "%.0f", k / 1024 }')" >>"$summary"
    done

    if [[ -n ${bg_pid:-} ]]; then
      wait "$bg_pid" 2>/dev/null || true
      bg_ops="$(awk '/stress-ng: metrc:/ && /cpu/ { print $(NF - 1) }' "$sess/background.txt" 2>/dev/null | tail -1 || true)"
      echo "session_bg_bogo_ops=${bg_ops:-missing}" >>"$summary"
    fi
    echo "session_terms=${KESTREL_SESSION_TERMS:-2}" >>"$summary"
    echo "session_tabs=${KESTREL_SESSION_TABS:-4}" >>"$summary"
    echo "session_seconds=$session_dur" >>"$summary"
    echo "session_bg_cpus=${KESTREL_SESSION_BG_CPUS:-0}" >>"$summary"
    awk '{ print "session_uptime_s=" $1 }' /proc/uptime >>"$summary"

    # Best-effort system-wide wakeups while the workload runs.
    if have powertop && [[ $EUID -eq 0 ]]; then
      powertop --csv="$sess/powertop.csv" --time=5 >/dev/null 2>&1 || true
      wk="$(awk -F'","' 'tolower($0) ~ /wakeups-from-idle/ { print $2; exit }' "$sess/powertop.csv" 2>/dev/null || true)"
      echo "session_powertop_wakeups=${wk:-missing}" >>"$summary"
    fi
  else
    echo "session=skipped (no Hyprland session; needs a live session)" | tee -a "$summary" | sed 's/^/  /'
  fi
fi

echo
echo "wrote $out"
echo "compare with: bench/compare <dirA> <dirB>"
