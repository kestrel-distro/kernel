#!/bin/bash

# Compare two `bench/run` result directories and print a delta table.
# Lower is better for latency and footprint metrics; higher is better for RPS
# and bogo ops; desktop CPU/RSS/GPU/wakeups are lower-is-better.
#
# Usage: bench/compare results/A results/B

set -euo pipefail

[[ $# -eq 2 ]] || {
  echo "Usage: bench/compare <dirA> <dirB>" >&2
  exit 1
}

a="${1%/}"
b="${2%/}"

value() { grep -E "^$2=" "$1/summary.txt" 2>/dev/null | head -1 | cut -d= -f2- || true; }

printf '%-26s %16s %16s %10s\n' "metric" "$(basename "$a")" "$(basename "$b")" "delta%"
printf '%-26s %16s %16s %10s\n' "------" "------" "------" "------"

for key in \
  schbench_wakeup_p50_us schbench_wakeup_p90_us schbench_wakeup_p99_us \
  schbench_rps cyclictest_max_us cyclictest_avg_us stress_cpu_bogo_ops \
  kernel_image_bytes modules_bytes modules_count loaded_modules \
  meminfo_slab_kb meminfo_sreclaimable_kb meminfo_sunreclaim_kb \
  meminfo_kernel_stack_kb meminfo_page_tables_kb meminfo_vmalloc_used_kb \
  boot_firmware_s boot_loader_s boot_kernel_s boot_userspace_s boot_total_s \
  desktop_hyprland_cpu_pct desktop_quickshell_cpu_pct \
  desktop_hyprland_rss_kb desktop_quickshell_rss_kb \
  desktop_nvidia_mem_mib desktop_nvidia_power_w desktop_nvidia_util_pct \
  desktop_powertop_wakeups; do
  va="$(value "$a" "$key")"
  vb="$(value "$b" "$key")"
  [[ -z $va || -z $vb ]] && continue
  [[ $va == missing || $vb == missing ]] && continue
  delta="$(awk -v x="$va" -v y="$vb" 'BEGIN { if (x == 0) print "n/a"; else printf "%+.1f", (y - x) / x * 100 }')"
  printf '%-26s %16s %16s %10s\n' "$key" "$va" "$vb" "$delta"
done

echo
echo "Latency and footprint metrics: lower is better."
echo "RPS and bogo ops: higher is better."
echo "Desktop CPU%, RSS, GPU mem/power/util and wakeups: lower is better."
