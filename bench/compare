#!/bin/bash

# Compare one or more `bench/run` result directories and print a delta table.
# Runs sharing a `variant=` line are grouped (that is how `bench/matrix` repeats
# are collapsed): each group is reported as median with [min..max]. The delta is
# against the first group. Lower is better for latency and footprint metrics;
# higher is better for RPS, bogo ops and throughput.
#
# Usage: bench/compare <dir> [<dir> ...]        # e.g. bench/compare results/matrix-*/*

set -euo pipefail

(( $# )) || {
  echo "Usage: bench/compare <dir> [<dir> ...]" >&2
  exit 1
}

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

groups=()
declare -A group_seen
keys=()
declare -A key_seen

for d in "$@"; do
  d="${d%/}"
  [[ -f $d/summary.txt ]] || { echo "compare: no summary.txt in $d" >&2; continue; }
  v="$(grep -E '^variant=' "$d/summary.txt" | head -1 | cut -d= -f2- || true)"
  [[ -z $v || $v == unlabelled ]] && v="$(basename "$d")"
  if [[ -z ${group_seen[$v]:-} ]]; then group_seen[$v]=1; groups+=("$v"); fi
  while IFS='=' read -r k val; do
    [[ -n $k && -n $val ]] || continue
    if [[ -z ${key_seen[$k]:-} ]]; then key_seen[$k]=1; keys+=("$k"); fi
    printf '%s\t%s\t%s\n' "$v" "$k" "$val" >>"$tmp"
  done < <(grep -E '^[A-Za-z0-9_.]+=' "$d/summary.txt")
done

(( ${#groups[@]} )) || { echo "compare: no usable result directories" >&2; exit 1; }

numeric() { [[ $1 =~ ^-?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$ ]]; }

stat_of() {
  local group="$1" key="$2" vals
  mapfile -t vals < <(awk -F'\t' -v g="$group" -v k="$key" \
    '$1==g && $2==k && $3!="missing" && $3!="-" { print $3 }' "$tmp")
  (( ${#vals[@]} )) || { printf '%s\t%s\t%s\n' "-" "-" "-"; return; }
  local allnum=1 x
  for x in "${vals[@]}"; do numeric "$x" || { allnum=0; break; }; done
  if (( ! allnum )); then
    printf '%s\t%s\t%s\n' "${vals[0]}" "-" "-"
    return
  fi
  printf '%s\n' "${vals[@]}" | sort -n | awk '
    { a[NR] = $1 }
    END {
      if (NR % 2) m = a[(NR + 1) / 2];
      else m = (a[NR / 2] + a[NR / 2 + 1]) / 2;
      printf "%.6g\t%.6g\t%.6g\n", m, a[1], a[NR];
    }'
}

echo "groups:"
for ((i = 0; i < ${#groups[@]}; i++)); do
  printf '  [%d] %s\n' "$((i + 1))" "${groups[i]}"
done
echo

printf '%-34s' "metric"
for ((i = 0; i < ${#groups[@]}; i++)); do printf ' %-18s' "[$((i + 1))]"; done
printf '\n'
printf '%-34s' "------"
for ((i = 0; i < ${#groups[@]}; i++)); do printf ' %-18s' "------"; done
echo

for key in "${keys[@]}"; do
  case "$key" in
    variant|label|mode|cmdline|cpu|nproc|governor|scx|scx_state|kernel|monitors|pkg_*) continue ;;
  esac
  line=""
  medians=()
  missing=0
  for g in "${groups[@]}"; do
    IFS=$'\t' read -r med lo hi < <(stat_of "$g" "$key")
    if [[ $med == "-" || $med == missing ]]; then
      medians+=("")
      line+="$(printf ' %-18s' "-")"
    else
      medians+=("$med")
      if [[ $lo == "-" || $lo == "$med" ]]; then cell="$med"; else cell="$med [$lo..$hi]"; fi
      line+="$(printf ' %-18s' "$cell")"
    fi
  done
  base="${medians[0]:-}"
  printf '%-34s%s' "$key" "$line"
  if [[ -n $base ]] && numeric "$base" && (( ${#medians[@]} > 1 )); then
    printf '   delta:'
    for ((i = 1; i < ${#medians[@]}; i++)); do
      m="${medians[i]}"
      if [[ -n $m ]] && numeric "$m"; then
        printf ' [%d]%+.1f%%' "$((i + 1))" "$(awk -v x="$base" -v y="$m" 'BEGIN { if (x == 0) print 0; else print (y - x) / x * 100 }')"
      fi
    done
  fi
  echo
done

echo
echo "Cells: median [min..max] over the runs in that group."
echo "Lower is better: latency, footprint, CPU%, RSS, wakeups."
echo "Higher is better: RPS, bogo ops, throughput."
